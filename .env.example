# A3 deployment env — copy to .env and fill secrets. NEVER commit .env.
DB_USERNAME=jt
DB_PASSWORD=change-me-local-only
DB_NAME=job_tracker

# 32+ chars each, required
JWT_SECRET=please-change-this-to-a-32-char-secret-value!
ENCRYPTION_SECRET=please-change-this-encryption-secret-32!

JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3101
NEXT_PUBLIC_API_URL=http://localhost:8081
